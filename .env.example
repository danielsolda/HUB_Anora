# ── Servidor ──
# Porta do backend. No Railway é definida automaticamente.
PORT=8787

# ── Banco de dados (movimentações do Kanban) ──
# No Railway, adicione o plugin PostgreSQL e esta variável é injetada sozinha.
# Sem ela, o servidor usa memória (não persiste entre reinícios).
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# ── Leitura da planilha privada (conta de serviço Google) ──
# Cole o JSON da conta de serviço em UMA linha, ou em base64.
# Sem isto, o Kanban mostra dados de exemplo (modo demonstração).
GOOGLE_SERVICE_ACCOUNT_JSON=

# (Opcional) sobrescrevem a planilha/aba lidas pelo servidor.
# SHEET_ID=1U6_a-W2dZAgWRzwXCNr3KRLbl7ygJrE21S-8LiMncD0
# SHEET_TAB=Respostas ao formulário 1

# ── Autenticação ──
# Segredo para assinar os tokens de login (JWT). Defina um valor longo e secreto;
# se mudar, todos precisam logar de novo. Sem ele, um segredo temporário é gerado
# a cada reinício (as sessões caem).
JWT_SECRET=

# Usuário "dono" criado no primeiro boot.
# OWNER_EMAIL=contatodanielsolda@gmail.com
# OWNER_NAME=Daniel Solda
# Se definir OWNER_PASSWORD, ela é usada; senão, uma senha aleatória é gerada e
# aparece nos logs do servidor (troque após o primeiro login).
# OWNER_PASSWORD=
